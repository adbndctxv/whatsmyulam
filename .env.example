# What'sMyUlam.ph - environment variables
#
# The MVP needs NO environment variables. The generator runs entirely on the
# local recipe data in src/data/.
#
# Copy this file to .env.local ONLY when a later milestone needs a value, and
# never commit the real file (.gitignore already blocks it).

# --- Milestone 6 (future, not used yet) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# SERVER-SIDE ONLY. Never expose this in client code or prefix it with NEXT_PUBLIC_:
# SUPABASE_SERVICE_ROLE_KEY=
