{
  "name": "whatsmyulam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What'sMyUlam.ph - Filipino ulam generator (Next.js website + TypeScript recipe engine).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm validate:data && pnpm typecheck && pnpm build",
    "test": "node --test \"src/**/*.test.ts\"",
    "validate:data": "node scripts/validate-data.ts",
    "suggest": "node scripts/suggest.ts"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
